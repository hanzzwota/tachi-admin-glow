# Supabase project URL (set this in your local environment or deployment secrets)
SUPABASE_URL=https://your-project.supabase.co
# Public key for browser/client use; never use it as the server secret.
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Server-only key. Never expose it as a VITE_* or commit a real value.
SUPABASE_SECRET_KEY=replace-with-server-only-secret
# JWKS endpoint used to verify Supabase access tokens in server handlers.
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Legacy alternative (use only if SUPABASE_SECRET_KEY is not set):
# SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Optional bootstrap credentials; keep real values in deployment secrets only.
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-admin-password
