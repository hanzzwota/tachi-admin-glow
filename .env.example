# Copy to .env for local development. Never commit the real .env.
# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Server-only secret key (sb_secret_... or legacy service_role JWT) from the SAME project as SUPABASE_URL.
SUPABASE_SECRET_KEY=
# Admin credentials used to create/validate the first admin profile.
ADMIN_USERNAME=
ADMIN_PASSWORD=
