# Copy this file to .env for local development.
# Never commit .env or paste secret values into source code.
SUPABASE_URL=https://eiwjpbfkxmtytmtiqpfj.supabase.co
# Use a valid server-side Supabase secret key here. Never commit the real value.
SUPABASE_SECRET_KEY=
# Optional aliases supported by the server:
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_KEY=
# SUPABASE_API_KEY=
ADMIN_USERNAME=ryueiei
ADMIN_PASSWORD=
# Set to 1 sementara saat mengukur latency query Supabase; jangan aktifkan permanen
# bila log provider tidak memiliki retensi dan akses yang memadai.
SUPABASE_PERF_LOG=0

# Email OTP login (Resend). AUTH_EMAIL_FROM must be a verified sender/domain in Resend.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
