# Supabase project URL (set this in local environment or deployment secrets)
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-only secret key. Never expose it as VITE_* or commit a real value.
SUPABASE_SECRET_KEY=replace-with-server-only-secret-key
# Legacy alternative; use only if SUPABASE_SECRET_KEY is not set:
# SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Optional bootstrap credentials. Keep real values in deployment secrets only.
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-admin-password
